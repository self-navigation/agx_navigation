<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
<!-- Physics system: Required for simulation stepping and collisions -->
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />

        <!-- UserCommands: Provides services like /world/default/create for spawning entities -->
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />

        <!-- SceneBroadcaster: Broadcasts scene info to the GUI so the world/robot is visible -->
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />

        <!-- Sensors: Enables sensor rendering/updates; required for your lidar and camera -->
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- Replaced Fuel include with embedded ground plane model to avoid download issues -->
    <!-- This defines a static infinite plane with basic friction and grey material -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>  <!-- Adjust size if needed for your environment -->
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>  <!-- Adjust size if needed -->
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

