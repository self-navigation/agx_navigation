# Plan a complete trajectory from an explicit start pose to a target pose.
# All poses are expressed in `frame_id`, which must match the planner's
# map_frame parameter (validated server-side; mismatches abort with a
# descriptive message and trajectory_id = 0).
string frame_id
float32 start_x          # [m]
float32 start_y          # [m]
float32 start_theta      # [rad]
float32 target_x         # [m]
float32 target_y         # [m]
float32 target_theta     # [rad]
---
# Terminal signal for the rollout.
bool success
string message
# 0 if no rollout was attempted (validation failure / field timeout /
# pre-rollout preemption); otherwise the planner-local id of the rollout
# this result terminates. Lets the interpreter distinguish "nothing ran"
# from "the rollout we were streaming just ended".
int32 trajectory_id
---
# One committed BVP segment: the first dt_segment seconds of a receding-
# horizon solve, sampled at control_rate Hz. All arrays are parallel --
# index i is the quantity at tick i, and the wheel command at tick i is
# applied at pose i. Chunks of one trajectory share trajectory_id and
# carry consecutive chunk_index values.
int32 trajectory_id
int32 chunk_index
float32 dt               # [s] sample spacing within the chunk

# BVP-planned chassis pose along the nominal.
float32[] pose_x         # [m]
float32[] pose_y         # [m]
float32[] pose_theta     # [rad]

# Publication-ready wheel-group velocity setpoints (post lead/deadzone/
# clip). The executor duplicates each per side for the 4-joint
# JointGroupVelocityController message [fl, rl, fr, rr] = [l, l, r, r],
# and may split a side's pair when applying per-wheel corrections.
float32[] wheel_left     # [rad/s]
float32[] wheel_right    # [rad/s]

# BVP-optimal wheel accelerations (the planned controls, pre-publication).
float32[] accel_left     # [rad/s^2]
float32[] accel_right    # [rad/s^2]

# PMP costates along the nominal -- the gradient of the segment's
# cost-to-go at each tick. Downstream uses: (a) neighboring-extremal
# feedback gains (the Riccati Q = H_xx depends pointwise on lam_x,
# lam_y); (b) the first-order plan-degradation metric lam' * dx for
# replan/correction triggering; (c) features for a learned corrector.
# Not reconstructible after the fact: lambda depends on per-solve
# pursuit references and the field snapshot. Per-segment quantity --
# mildly discontinuous across chunk boundaries by construction.
float32[] lam_x
float32[] lam_y
float32[] lam_theta
float32[] lam_wheel_left
float32[] lam_wheel_right
