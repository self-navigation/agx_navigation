	branch = master
[submodule "src/rslidar_sdk"]
	path = src/rslidar_sdk
	url = https://github.com/self-navigation/rslidar_sdk.git
	branch = main
[submodule "src/ugv_sdk"]
	path = src/ugv_sdk
	url = https://github.com/agilexrobotics/ugv_sdk.git
	branch = main
[submodule "src/scout_ros2"]
	path = src/scout_ros2
	url = https://github.com/self-navigation/scout_ros2.git
	branch = main
[submodule "src/realsense-ros"]
	path = src/realsense-ros
