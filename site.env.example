# Site file for the remote-VM helpers (tools/agx-route, `just ssh-config`,
# tools/jobs/lib_ntfy.sh, tools/notify_when_done). Copy it to
# ~/.config/agx/site.env (or point AGX_SITE_ENV at it) and fill it in. It is
# sourced by bash, so no spaces around `=`.

# Direct route (lab VPN).
AGX_DIRECT_HOST=
AGX_DIRECT_PORT=22
# Jump route: user@host of the jump host, and the VM as seen from it.
AGX_JUMP_PROXY=
AGX_JUMP_PROXY_PORT=22
AGX_JUMP_TARGET=
AGX_JUMP_TARGET_PORT=22
# Login user on the VM.
AGX_USER=programmer
# Job notifications (optional; empty disables them).
NTFY_URL=
